  "components": {
    "schemas": {
      "ChangePasswordDto": {
        "required": [
          "nuevaPassword",
          "passwordActual"
        ],
        "type": "object",
        "properties": {
          "passwordActual": {
            "minLength": 1,
            "type": "string"
          },
          "nuevaPassword": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string",
            "format": "password"
          },
          "confirmarPassword": {
            "type": "string",
            "format": "password",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "required": [
          "correo",
          "password"
        ],
        "type": "object",
        "properties": {
          "correo": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequestDto": {
        "required": [
          "correo",
          "nombre",
          "rol"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "correo": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "rol": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Verify2FaDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "codigo": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Ingrese únicamente el token JWT.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
